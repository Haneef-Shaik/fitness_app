{
  "name": "@fitlog/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && node scripts/test-design-rules.cjs",
    "test": "jest --runInBand",
    "test:ci": "node --test ../../scripts/quality/*.test.mjs && node ../../scripts/quality/coverage-ratchet.mjs && jest --runInBand --ci --coverage --no-watchman",
    "test:coverage": "jest --runInBand --ci --coverage",
    "export:web": "expo export --platform web",
    "theme:generate": "node --import tsx scripts/generate-palette.ts"
  },
  "dependencies": {
    "@expo-google-fonts/google-sans-flex": "0.4.6",
    "@expo-google-fonts/noto-sans-devanagari": "0.4.1",
    "@expo-google-fonts/roboto-condensed": "0.4.2",
    "@fitlog/domain": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "0.86.3",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "~6.0.3"
  }
}
