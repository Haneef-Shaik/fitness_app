  "local_date": [
    {
      "instant": "2026-09-21T18:20:00Z",
      "timezone": "Asia/Kolkata",
      "expected_local_date": "2026-09-21",
      "note": "23:50 local \u2014 still the same day"
    },
    {
      "instant": "2026-09-21T18:40:00Z",
      "timezone": "Asia/Kolkata",
      "expected_local_date": "2026-09-22",
      "note": "00:10 local \u2014 rolled over"
    },
    {
      "instant": "2026-09-21T23:40:00Z",
      "timezone": "Asia/Kolkata",
      "expected_local_date": "2026-09-22",
      "note": "half-hour offset"
    },
    {
      "instant": "2026-11-01T05:30:00Z",
      "timezone": "America/New_York",
      "expected_local_date": "2026-11-01",
      "note": "01:30 EDT, before DST ends"
    },
    {
      "instant": "2026-11-01T06:30:00Z",
      "timezone": "America/New_York",
      "expected_local_date": "2026-11-01",
      "note": "01:30 EST, the repeated hour"
    },
    {
      "instant": "2026-03-08T06:30:00Z",
      "timezone": "America/New_York",
      "expected_local_date": "2026-03-08",
      "note": "23-hour day, spring forward"
    },
    {
      "instant": "2026-09-21T11:00:00Z",
      "timezone": "Pacific/Kiritimati",
      "expected_local_date": "2026-09-22",
      "note": "UTC+14, extreme positive"
    },
    {
      "instant": "2026-09-21T10:00:00Z",
      "timezone": "Pacific/Niue",
      "expected_local_date": "2026-09-20",
      "note": "UTC-11, extreme negative"
    },
    {
      "instant": "2026-09-21T00:00:00Z",
      "timezone": "UTC",
      "expected_local_date": "2026-09-21",
      "note": "baseline"
    }
  ],
  "set_validity": [
    {
      "name": "reps only is valid",
      "set": {
        "reps": 10
      },
      "expected_valid": true
    },
    {
      "name": "duration only is valid",
      "set": {
        "duration_seconds": 60
      },
      "expected_valid": true
    },
    {
      "name": "distance only is valid",
      "set": {
        "distance_m": 400
      },
      "expected_valid": true
    },
    {
      "name": "load alone is not a set",
      "set": {
        "load_kg": 100
      },
      "expected_valid": false,
      "expected_error": "Add reps, time or distance to save this set."
    },
    {
      "name": "empty set",
      "set": {},
      "expected_valid": false,
      "expected_error": "Add reps, time or distance to save this set."
    },
    {
      "name": "zero reps",
      "set": {
        "reps": 0
      },
      "expected_valid": false,
      "expected_error": "Reps must be a whole number of at least 1."
    },
    {
      "name": "negative load",
      "set": {
        "load_kg": -5,
        "reps": 8
      },
      "expected_valid": false,
      "expected_error": "Load cannot be negative."
    },
    {
      "name": "bodyweight set is valid",
      "set": {
        "reps": 15,
        "load_kg": null
      },
      "expected_valid": true
    }
  ],
