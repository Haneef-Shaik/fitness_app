  "goal_progress": [
    {
      "start": 80.0,
      "target": 75.0,
      "current": 78.5,
      "direction": "down",
      "expected": 0.3,
      "note": "80 to 75 is 5 kg; 80 to 78.5 is 1.5 of them"
    },
    {
      "start": 80.0,
      "target": 75.0,
      "current": 80.0,
      "direction": "down",
      "expected": 0.0,
      "note": "measured, and exactly where they started"
    },
    {
      "start": 80.0,
      "target": 75.0,
      "current": 75.0,
      "direction": "down",
      "expected": 1.0,
      "note": "arrived"
    },
    {
      "start": 80.0,
      "target": 75.0,
      "current": 72.0,
      "direction": "down",
      "expected": 1.0,
      "note": "overshoot is complete, never more than complete"
    },
    {
      "start": 80.0,
      "target": 75.0,
      "current": 81.0,
      "direction": "down",
      "expected": -0.2,
      "note": "the wrong way is NEGATIVE, not clamped to zero - hiding it behind a 0% meter is how someone finds out in three months"
    },
    {
      "start": 70.0,
      "target": 78.0,
      "current": 74.0,
      "direction": "up",
      "expected": 0.5,
      "note": "gaining works the same way in the other direction"
    },
    {
      "start": 70.0,
      "target": 78.0,
      "current": 68.0,
      "direction": "up",
      "expected": -0.25,
      "note": "losing weight while trying to gain it"
    },
    {
      "start": 75.0,
      "target": 75.0,
      "current": 75.0,
      "direction": "hold",
      "expected": 1.0,
      "note": "holding, and holding it - a zero-width target would divide by zero"
    },
    {
      "start": 75.0,
      "target": 75.0,
      "current": 76.5,
      "direction": "hold",
      "expected": 0.0,
      "note": "holding, and not holding it. 1.5 kg out of a 75 kg target is beyond the 1% band"
    },
    {
      "start": 75.0,
      "target": 75.0,
      "current": 75.3,
      "direction": "hold",
      "expected": 1.0,
      "note": "within the band a scale moves on its own"
    },
    {
      "start": null,
      "target": 75.0,
      "current": 78.0,
      "direction": "down",
      "expected": null,
      "note": "no starting point means no denominator - null, never 0"
    },
    {
      "start": 80.0,
      "target": 75.0,
      "current": null,
      "direction": "down",
      "expected": null,
      "note": "not measured yet is not the same as no progress"
    }
