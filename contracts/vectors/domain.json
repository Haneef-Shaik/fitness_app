{
  "$comment": "Cross-language contract. Both packages/domain (TypeScript) and services/api (Python) MUST pass these. Generated from the formulas stated in docs/02 and docs/05. Edit the docs first, then regenerate.",
  "tolerance": 1e-09,
  "constants": {
    "KG_PER_LB": 0.45359237,
    "CM_PER_IN": 2.54,
    "e1rm_formula": "epley_v1"
  },
  "volume": [
    {
      "name": "single working set",
      "sets": [
        {
          "set_type": "working",
          "load_kg": 100,
          "reps": 8,
          "completed": true
        }
      ],
      "expected_volume_kg": 800
    },
    {
      "name": "warm-up excluded (D6)",
      "sets": [
        {
          "set_type": "warmup",
          "load_kg": 40,
          "reps": 12,
          "completed": true
        },
        {
          "set_type": "working",
          "load_kg": 100,
          "reps": 8,
          "completed": true
        }
      ],
      "expected_volume_kg": 800.0
    },
    {
      "name": "incomplete set contributes nothing",
      "sets": [
        {
          "set_type": "working",
          "load_kg": 100,
          "reps": 8,
          "completed": false
        }
      ],
      "expected_volume_kg": 0.0
    },
    {
      "name": "bodyweight set has no load volume",
      "sets": [
        {
          "set_type": "working",
          "load_kg": null,
          "reps": 15,
          "completed": true
        }
      ],
      "expected_volume_kg": 0.0
    },
    {
      "name": "drop and failure sets count",
      "sets": [
        {
          "set_type": "working",
          "load_kg": 80,
          "reps": 8,
          "completed": true
        },
        {
          "set_type": "drop",
          "load_kg": 60,
          "reps": 10,
          "completed": true
        },
        {
          "set_type": "failure",
          "load_kg": 60,
          "reps": 6,
          "completed": true
        }
      ],
      "expected_volume_kg": 1600
    },
    {
      "name": "bench session from the designs",
      "sets": [
        {
          "set_type": "warmup",
          "load_kg": 40,
          "reps": 12,
          "completed": true
        },
        {
          "set_type": "working",
          "load_kg": 80,
          "reps": 8,
          "completed": true
        },
        {
          "set_type": "working",
          "load_kg": 80,
          "reps": 8,
          "completed": true
        },
        {
          "set_type": "working",
          "load_kg": 80,
          "reps": 7,
          "completed": true
        },
        {
          "set_type": "working",
          "load_kg": 77.5,
          "reps": 8,
          "completed": true
        }
      ],
      "expected_volume_kg": 2460.0
    },
    {
      "name": "empty session",
      "sets": [],
      "expected_volume_kg": 0
    }
  ],
  "e1rm": [
    {
      "name": "standard working set",
      "load_kg": 100,
      "reps": 8,
      "expected_e1rm_kg": 126.666666667
