  "set_validity": [
    {
      "name": "reps only is valid",
      "set": {
        "reps": 10
      },
      "expected_valid": true
    },
    {
      "name": "duration only is valid",
      "set": {
        "duration_seconds": 60
      },
      "expected_valid": true
    },
    {
      "name": "distance only is valid",
      "set": {
        "distance_m": 400
      },
      "expected_valid": true
    },
    {
      "name": "load alone is not a set",
      "set": {
        "load_kg": 100
      },
      "expected_valid": false,
      "expected_error": "Add reps, time or distance to save this set."
    },
    {
      "name": "empty set",
      "set": {},
      "expected_valid": false,
      "expected_error": "Add reps, time or distance to save this set."
    },
    {
      "name": "zero reps",
      "set": {
        "reps": 0
      },
      "expected_valid": false,
      "expected_error": "Reps must be a whole number of at least 1."
    },
    {
      "name": "negative load",
      "set": {
        "load_kg": -5,
        "reps": 8
      },
      "expected_valid": false,
      "expected_error": "Load cannot be negative."
    },
    {
      "name": "bodyweight set is valid",
      "set": {
        "reps": 15,
        "load_kg": null
      },
      "expected_valid": true
    }
