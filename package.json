{
  "name": "fitlog",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "supabase": "supabase",
    "plan:build": "node scripts/plan/build.mjs",
    "plan:board": "node scripts/plan/serve.mjs",
    "plan:status": "node scripts/plan/status.mjs",
    "plan:test": "node --test scripts/plan/lib.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "strip-ansi>ansi-regex": "^5.0.1"
    },
    "packageExtensions": {
      "react-native-drawer-layout": {
        "peerDependenciesMeta": {
          "react-native-reanimated": {
            "optional": true
          },
          "react-native-gesture-handler": {
            "optional": true
          }
        }
      }
    },
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
