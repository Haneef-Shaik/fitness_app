# FitLog API settings. Copy to .env for development; in staging and production
# every one of these is an environment variable on the host (docs/12-DEPLOYMENT.md
# §4 has the full table: required or not, and where each value comes from).
# NEVER commit a real value — .env is gitignored, this file is not.

# "development" (default) | "test" | "staging" | "production". Staging and
# production refuse to start on development secrets, local storage or a
# database URL without TLS.
ENVIRONMENT=development

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fitlog:fitlog@localhost:5432/fitlog
TEST_DATABASE_URL=postgresql+asyncpg://fitlog:fitlog@localhost:5433/fitlog_test
# Hosted (Supabase): the SESSION pooler, with the driver changed to asyncpg and
# TLS required — `sslmode=require` works too, it is translated for asyncpg:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?ssl=require
#
# "session" (default): a direct connection or the session pooler (port 5432).
# "transaction": the transaction pooler (port 6543) — prepared statements off,
# no client-side pool. Session mode unless you run out of connections.
DB_POOL_MODE=session
# Per process, session mode only. API replicas x (size + overflow) + worker +
# one migration must fit the pooler's pool size (docs/12 §3).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Auth ----------------------------------------------------------------------
# HS256 needs >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-not-long-enough-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# --- AI food analysis (G8) -----------------------------------------------------
# "stub" is the default: deterministic, offline, free, and what the tests use.
# Set to "anthropic" and supply a key to use a real model.
AI_PROVIDER=stub
AI_MODEL=claude-sonnet-5
# NEVER commit a real key. Export it in your shell or put it in .env (gitignored).
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_DAILY_QUOTA=25
# Below this confidence an AI item starts UNCHECKED (N04.3).
AI_LOW_CONFIDENCE_THRESHOLD=0.5
# Point this at a proxy or a self-hosted gateway if you have one.
AI_BASE_URL=https://api.anthropic.com/v1/messages
WORKER_POLL_SECONDS=2

# --- Uploads and photo storage -------------------------------------------------
# "local" (development, the suite) writes under UPLOAD_ROOT. "s3" is any
# S3-compatible bucket — Supabase Storage when hosted. Staging and production
# refuse "local": a container's disk does not survive a deploy.
STORAGE_BACKEND=local
UPLOAD_ROOT=var/uploads
UPLOAD_MAX_BYTES=8388608
# Any request body (by Content-Length); the proxy should enforce the same.
MAX_BODY_BYTES=12582912
# How long a signed URL lives — the upload PUT and the photo GET alike.
UPLOAD_URL_TTL_SECONDS=600
# Its own secret, not the JWT one. Generate: openssl rand -base64 48
UPLOAD_SIGNING_SECRET=dev-only-change-me
# Point this at a proxy or a self-hosted gateway if you have one.
AI_BASE_URL=https://api.anthropic.com/v1/messages

# --- Email (A-05 reset, A-06 verify, K-02 email change) ----------------------
# "console" is the default: nothing is sent, each message is kept in memory and
# echoed to the server log in development so you can open the link. Production
# refuses to start on "console". Set to "resend" and supply a key to send.
EMAIL_PROVIDER=console
# NEVER commit a real key. Export it in your shell or put it in .env (gitignored).
EMAIL_API_KEY=
# An address the provider has verified, e.g. FitLog <no-reply@your-domain>
EMAIL_FROM=
EMAIL_BASE_URL=https://api.resend.com/emails
EMAIL_TIMEOUT_SECONDS=10
# Where emailed links open. "fitlog" is the scheme in apps/mobile/app.json.
APP_LINK_BASE=fitlog://
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- Operators (launch) --------------------------------------------------------
# Production refuses to start without it (>= 32 chars). It is the bearer that
# opens /metrics and /v1/admin/* in production; elsewhere it is ignored.
# Generate: openssl rand -base64 48
ADMIN_TOKEN=
# Printed on /legal/privacy and /legal/terms as the contact address.
SUPPORT_EMAIL=
# Where people reach this API (https:// in production). The policies print the
# account-deletion link from it — the URL Google Play lists. Never taken from a
# request's Host header; empty makes those links relative.
PUBLIC_BASE_URL=

# --- Rate limiting (launch) ----------------------------------------------------
RATE_LIMITS_ENABLED=true
# Reverse proxies in front of the API that APPEND to X-Forwarded-For. Leave 0
# unless there is one: with 0 the header is ignored, because without a proxy
# writing it, any caller can.
TRUSTED_PROXY_COUNT=0
# "<count>/<second|minute|hour|day>", per address (_IP) and per account (_ACCOUNT).
RATE_LIMIT_LOGIN_IP=10/minute
RATE_LIMIT_LOGIN_ACCOUNT=5/minute
# Every address together, for one account.
RATE_LIMIT_LOGIN_TOTAL_ACCOUNT=30/hour
RATE_LIMIT_REGISTER_IP=10/hour
RATE_LIMIT_REGISTER_ACCOUNT=5/hour
RATE_LIMIT_REFRESH_IP=30/minute
RATE_LIMIT_REFRESH_ACCOUNT=10/minute
RATE_LIMIT_ACCOUNT_DELETE_IP=10/hour
RATE_LIMIT_ACCOUNT_DELETE_ACCOUNT=5/hour
RATE_LIMIT_AI_IP=30/minute
RATE_LIMIT_AI_ACCOUNT=10/minute
RATE_LIMIT_PASSWORD_RESET_IP=10/hour
RATE_LIMIT_PASSWORD_RESET_ACCOUNT=5/hour
RATE_LIMIT_PASSWORD_RESET_TOTAL_ACCOUNT=20/day
RATE_LIMIT_EMAIL_VERIFY_IP=30/hour
RATE_LIMIT_EMAIL_VERIFY_ACCOUNT=30/hour
RATE_LIMIT_IMPORTS_IP=20/hour
RATE_LIMIT_IMPORTS_ACCOUNT=10/hour
RATE_LIMIT_FEEDBACK_IP=20/hour
RATE_LIMIT_FEEDBACK_ACCOUNT=10/hour
RATE_LIMIT_REAUTH_IP=20/hour
RATE_LIMIT_REAUTH_ACCOUNT=10/hour

# --- Push ("your meal estimate is ready") --------------------------------------
# "none" (default) sends nothing. "expo" uses Expo's push service; the app must
# be linked to an Expo project (`eas init`) for phones to get a token at all.
PUSH_PROVIDER=none
# Only if "enhanced push security" is switched on for the Expo project.
EXPO_ACCESS_TOKEN=

# --- Service status (L-08) ------------------------------------------------------
# true answers every call but /health and /v1/status with a 503 and this message.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
# "AI degraded" is observed, not declared: at least N finished analyses in the
# window, and at least this share of them failed at the provider.
AI_DEGRADED_WINDOW_MINUTES=15
AI_DEGRADED_MIN_SAMPLES=5
AI_DEGRADED_FAILURE_RATIO=0.5

# Required when STORAGE_BACKEND=s3. The bucket must be PRIVATE.
# Supabase: Storage > S3 Connection — endpoint, region, and an access key pair.
S3_ENDPOINT_URL=
# e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3 (empty = AWS S3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Supabase project — server-only (docs/14). Photo thumbnails from Storage's
# image transformation; empty = no thumbnails, the app shows originals.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Crash reporting (Sentry) --------------------------------------------------
# Empty = off (the default). Events carry no emails, bodies, tokens or queries.
SENTRY_DSN=
# Which build is running. The Docker image sets it (fitlog-api@<git sha>);
# only set it by hand outside the image.
APP_RELEASE=
